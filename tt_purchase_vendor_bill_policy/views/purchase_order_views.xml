<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_view_form_inherit_tt_bill_policy" model="ir.ui.view">
        <field name="name">purchase.order.form.tt_purchase_bill_policy</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <!-- v19: the 'done' state was removed from purchase.order
                     (replaced by a separate 'locked' boolean). Read-only gate
                     covers the confirmed and cancelled states only. -->
                <field name="tt_purchase_bill_policy"
                       readonly="state in ('purchase', 'cancel')"/>
            </xpath>
        </field>
    </record>

</odoo>
